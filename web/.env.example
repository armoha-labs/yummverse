# Only needed when the web app is deployed separately from the backend (e.g. Vercel +
# Render) — set this to the backend's public URL. Leave unset for local dev; Vite's dev
# server proxy (vite.config.ts) forwards /api/v1 to http://localhost:4000 instead.
VITE_API_URL=https://your-backend.onrender.com

# Optional — from Firebase Console > Project Settings > Cloud Messaging > Web Push
# certificates. Omit to skip push-notification registration entirely (the app still works;
# order-status updates just rely on in-app polling/sockets instead of OS push).
VITE_FIREBASE_VAPID_KEY=
