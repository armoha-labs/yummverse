NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/yummverse

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Dev-only example key — DO NOT use in any real deployment. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=kY0Lj3TfXQt86HGiBbx5xMVJUckyApqilR50okbOxfY=

FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000

# Optional — omit all three to fall back to local-disk storage under backend/uploads (dev only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — omit both to fall back to logging push payloads instead of sending (§40A)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional — omit SMTP_HOST to fall back to logging invite emails instead of sending (§54)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
